# =============================================================================
# ZeroPhish Root .gitignore
# =============================================================================

# Environments & Secrets (CRITICAL: Never commit secrets!)
.env
.env.*
.env.local
.env.staging
.env.production
.env.development
!.env.example
!.env.*.example
!.env.staging.example

# Virtual Environments
.venv/
venv/
env/
ENV/
.env/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing, Linting & Coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover

# Node & Next.js Build Outputs
node_modules/
.next/
out/
Frontend/.next/
Frontend/out/
*.tsbuildinfo
.turbo/

# Logs & Temporary Files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.bak
*.swp
*.swo
*~

# Databases
*.db
*.db-journal
*.sqlite
*.sqlite3
*.staging.db
staging_data/
staging_zerophish.db

# OS & Editor
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
.vscode/
.idea/

# Local ML Model Artifacts & Weights (Never commit heavy binaries or caches)
/models/
Backend/models/.locks/
Backend/models/models--*/
Backend/models/*.bin
Backend/models/*.pt
Backend/models/*.pth
Backend/models/*.onnx
Backend/models/*.safetensors
Backend/ml/models/*.bin
Backend/ml/models/*.pt
Backend/ml/models/*.pth
Backend/ml/models/*.onnx
Backend/ml/models/*.safetensors
Backend/ml/data/raw/
Backend/ml/data/processed/
*.onnx
*.safetensors
*.bin
*.pt
*.pth
