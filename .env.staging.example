# ==============================================================================
# ZeroPhish — Staging Environment Configuration Template (Clerk Identity)
# ==============================================================================
# Copy to .env.staging and populate with staging-specific secrets.
# NEVER commit real credentials to version control.

# Deployment Environment
ZEROPHISH_ENV=staging

# Staging Network Target & Host Allowlists
ZEROPHISH_STAGING_BASE_URL=http://127.0.0.1:8000
ZEROPHISH_STAGING_ALLOWED_HOSTS=127.0.0.1,localhost,staging.zerophish.internal

# Staging Isolated Database & Cache
DATABASE_URL=sqlite:///./staging_zerophish.db
REDIS_URL=redis://127.0.0.1:6379/1

# Staging Clerk Identity Provider
CLERK_SECRET_KEY=your_staging_clerk_secret_key_here
CLERK_JWT_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_staging_clerk_publishable_key_here
CLERK_ADMIN_USER_IDS=user_clerk_staging_admin

# Staging Shadow Cascade Mode
ZEROPHISH_CASCADE_SHADOW_MODE=true
ZEROPHISH_CASCADE_SHADOW_SAMPLE_RATE=0.10
MAX_SHADOW_CASCADE_CONCURRENCY=10
CASCADE_SHADOW_TIMEOUT_MS=2000

# Staging Timeouts & Retries
EXTERNAL_STAGING_CONNECT_TIMEOUT_SECONDS=5.0
EXTERNAL_STAGING_READ_TIMEOUT_SECONDS=15.0
EXTERNAL_STAGING_WRITE_TIMEOUT_SECONDS=10.0
EXTERNAL_STAGING_POOL_TIMEOUT_SECONDS=5.0
EXTERNAL_STAGING_REQUEST_TIMEOUT_SECONDS=20.0
EXTERNAL_STAGING_MAX_RUNTIME_SECONDS=300.0
EXTERNAL_STAGING_MAX_RETRIES=3
EXTERNAL_STAGING_MAX_ERRORS=10
EXTERNAL_STAGING_PROGRESS_EVERY=100
EXTERNAL_STAGING_CONCURRENCY=20

# Optional Staging API Token
ZEROPHISH_STAGING_API_TOKEN=staging_token_placeholder
