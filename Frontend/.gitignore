# =============================================================================
# ZeroPhish Frontend .gitignore
# =============================================================================

# Dependencies
node_modules/
/.pnp
.pnp.js

# Testing
/coverage
.nyc_output

# Next.js Build Outputs
/.next/
/out/
build/
dist/

# TypeScript Cache
*.tsbuildinfo

# Environment Variables & Secrets
.env
.env*.local
.env.production
.env.development
!.env.example
!.env.*.example

# Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Turbopack & Bundler Cache
.turbo/

# OS & Editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# v0 runtime files (should only exist in preview, not in git)
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts