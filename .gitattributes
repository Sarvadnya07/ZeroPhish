# =============================================================================
# ZeroPhish Root .gitattributes
# Ensures consistent line endings across Windows, Linux, and macOS
# =============================================================================

# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit LF for source code and configurations
*.py text eol=lf
*.pyi text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows shell scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.onnx binary
*.safetensors binary
*.bin binary
*.pt binary
*.pth binary
*.pyc binary
*.pyo binary
*.exe binary
*.dll binary
*.so binary
