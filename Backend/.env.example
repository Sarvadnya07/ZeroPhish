# ZeroPhish Backend Environment Configuration
# ==========================================

# ── General Server ──────────────────────────────────
ENV=development                    # development | production | testing
GATEWAY_PORT=8001
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_BEFORE_PRODUCTION
AUTH_TOKEN_TTL=86400               # 24 hours in seconds
TIER3_TIMEOUT=5                    # Max seconds to wait for AI analysis
GATEWAY_SCAN_HISTORY_LIMIT=500

# ── CORS Configuration ─────────────────────────────
# Comma-separated allowed origins. Do NOT use wildcards in production with credentials.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# To allow a specific Chrome extension ID:
# ALLOW_ORIGIN_REGEX=chrome-extension://(your-extension-id-here)

# ── External AI & Metadata (Tier 3) ────────────────
# Required for Gemini AI threat analysis
GEMINI_API_KEY=your_actual_gemini_api_key_here

# ── Caching & Persistent Stores ────────────────────
# Required for scan response caching and WHOIS lookup cache
REDIS_URL=redis://localhost:6379

# ── WHOIS Provider ─────────────────────────────────
WHOIS_API_PROVIDER=whoisxml        # whoisxml | whoisapi
WHOIS_API_KEY=                     # Optional: fallback to local whois if empty
WHOIS_CACHE_TTL=86400

# ── Authentication & Security ───────────────────────
# API_KEY=your_secure_api_key_here
# JWT_SECRET=generate_a_random_32char_string_here

# ── Multi-Module Configuration ──────────────────────
# URL used for internal live dashboard notifications
LIVE_DASHBOARD_URL=http://127.0.0.1:8000/tier1/report

# ── OAuth Configuration ─────────────────────────────
ENABLE_MOCK_OAUTH=false            # Set to true only in local development
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
