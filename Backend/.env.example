# ZeroPhish Backend Environment Configuration
# ==========================================

# ── General Server ──────────────────────────────────
GATEWAY_PORT=8001
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ZeroPhish@Admin1
TIER3_TIMEOUT=5  # Max seconds to wait for AI analysis
GATEWAY_SCAN_HISTORY_LIMIT=500

# ── CORS Configuration ─────────────────────────────
# Comma-separated origins. Include localhost:3000 (Next.js) and port 8000 (Backend)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# To allow a specific Chrome extension ID:
# ALLOW_ORIGIN_REGEX=chrome-extension://(your-extension-id-here)

# ── External AI & Metadata (Tier 3) ────────────────
# Required for Gemini 1.5 Flash AI analysis
GEMINI_API_KEY=your_actual_gemini_api_key_here

# ── Caching (Speed Layer) ───────────────────────────
# Required for 5-minute scan response caching
REDIS_URL=redis://localhost:6379

# ── Authentication & Security ───────────────────────
# API_KEY=your_secure_api_key_here
# JWT_SECRET=generate_a_random_32char_string_here (Optional for advanced auth)

# ── Multi-Module Configuration ──────────────────────
# URL used for internal live dashboard notifications
LIVE_DASHBOARD_URL=http://127.0.0.1:8000/tier1/report

# ── OAuth Mocking (Development) ─────────────────────
# Replace with real IDs for production OAuth2 flows
GOOGLE_CLIENT_ID=mock_client_id
MICROSOFT_CLIENT_ID=mock_client_id
