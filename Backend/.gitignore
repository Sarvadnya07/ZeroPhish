# =============================================================================
# ZeroPhish Backend .gitignore
# =============================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/

# Environment Variables & Secrets (CRITICAL: Never commit secrets!)
.env
.env.*
!.env.example
!.env.*.example

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs & Temporary Files
*.log
logs/
*.tmp
*.bak

# ML Models & Caches (Large Binary Files)
models/.locks/
models/models--*/
models/*.bin
models/*.pt
models/*.pth
models/*.onnx
models/*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.safetensors

# Testing & Coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover

# Databases
*.db
*.db-journal
*.sqlite
*.sqlite3
